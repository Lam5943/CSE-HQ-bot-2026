# Discord
DISCORD_TOKEN=
AI_ENABLE_MESSAGE_CONTENT=false

# Database / application
DATABASE_PATH=./cse_hq.db

# AI
AI_PROVIDER=fake

# Recommended free production provider
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Gemini provider
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=

# Bounded request budget
AI_MAX_CONTEXT_ITEMS=6
AI_MAX_HISTORY_MESSAGES=4
AI_REQUEST_TIMEOUT=30
AI_PRIMARY_RETRIES=1

# Optional paid fallback (disabled by default)
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

AI_ACTION_EXPIRATION_SECONDS=600

# GitHub read integration
GITHUB_ENABLED=false
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=
GITHUB_TOKEN=
GITHUB_REQUEST_TIMEOUT=15
GITHUB_CACHE_TTL=300
GITHUB_MAX_RESULTS=30
GITHUB_BUG_LABEL=bug

# GitHub webhook
GITHUB_WEBHOOK_ENABLED=false
GITHUB_WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
GITHUB_WEBHOOK_PATH=/webhooks/github

# Operational settings
LOG_LEVEL=INFO

# Forum channel mappings are configured with /setup forums and stored in SQLite.
# No production IDs or secrets belong in this file.
